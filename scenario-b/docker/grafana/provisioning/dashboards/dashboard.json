          "legendFormat": "p99 - {{query_name}}"
        },
        {
          "expr": "sum(rate(db_query_duration_seconds_count[2m])) by (query_name)",
          "legendFormat": "rate - {{query_name}}"
        }
      ]
    },
    {
      "title": "Panel E — The N+1 Detector (DB Queries Per Request)",
      "type": "timeseries",
